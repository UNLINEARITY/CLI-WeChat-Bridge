{
  "name": "cli-wechat-bridge",
  "version": "1.2.3",
  "description": "CLI bridge for Codex, Claude Code, OpenCode, and Pi over WeChat, WeCom, and Telegram",
  "type": "module",
  "files": [
    "bin/",
    "dist/",
    "scripts/ensure-node-pty-permissions.mjs",
    "README.md",
    "README_EN.md",
    "LICENSE.txt",
    "skills/codex-bridge/"
  ],
  "keywords": [
    "wechat",
    "wecom",
    "telegram",
    "cli",
    "bridge",
    "codex",
    "claude",
    "opencode",
    "pi",
    "terminal"
  ],
  "author": "UNLINEARITY",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UNLINEARITY/CLI-WeChat-Bridge.git"
  },
  "bugs": {
    "url": "https://github.com/UNLINEARITY/CLI-WeChat-Bridge/issues"
  },
  "homepage": "https://github.com/UNLINEARITY/CLI-WeChat-Bridge#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "wechat-codex": "bin/wechat-codex.mjs",
    "wechat-claude": "bin/wechat-claude.mjs",
    "wechat-opencode": "bin/wechat-opencode.mjs",
    "wechat-pi": "bin/wechat-pi.mjs",
    "wechat-daemon": "bin/wechat-daemon.mjs",
    "wechat-setup": "bin/wechat-setup.mjs",
    "wechat-check-update": "bin/wechat-check-update.mjs",
    "wecom-codex": "bin/wecom-codex.mjs",
    "wecom-claude": "bin/wecom-claude.mjs",
    "wecom-opencode": "bin/wecom-opencode.mjs",
    "wecom-pi": "bin/wecom-pi.mjs",
    "wecom-daemon": "bin/wecom-daemon.mjs",
    "wecom-setup": "bin/wecom-setup.mjs",
    "wecom-check-update": "bin/wecom-check-update.mjs",
    "telegram-codex": "bin/telegram-codex.mjs",
    "telegram-claude": "bin/telegram-claude.mjs",
    "telegram-opencode": "bin/telegram-opencode.mjs",
    "telegram-pi": "bin/telegram-pi.mjs",
    "telegram-daemon": "bin/telegram-daemon.mjs",
    "telegram-setup": "bin/telegram-setup.mjs",
    "telegram-check-update": "bin/telegram-check-update.mjs"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-node-pty-permissions.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "eslint bin src test",
    "lint:fix": "eslint bin src test --fix",
    "typecheck:src": "tsc -p tsconfig.typecheck.src.json --noEmit --pretty false",
    "quality": "npm run lint && npm run typecheck:src && bun test test && npm run build",
    "smoke:global": "node scripts/smoke-global-install.mjs",
    "smoke:cli-compat": "node scripts/smoke-cli-compatibility.mjs",
    "e2e": "node scripts/e2e/run-e2e.mjs",
    "publish:dual": "node scripts/publish-dual.mjs",
    "setup": "node --no-warnings --experimental-strip-types src/wechat/setup.ts",
    "start": "node --no-warnings --experimental-strip-types src/wechat/wechat-channel.ts",
    "check": "node --no-warnings --experimental-strip-types src/wechat/wechat-channel.ts --check",
    "daemon": "node --no-warnings --experimental-strip-types src/daemon/wechat-daemon.ts",
    "codex:panel": "node --no-warnings --experimental-strip-types src/companion/codex-remote-client.ts",
    "codex:start": "node --no-warnings --experimental-strip-types src/companion/local-companion-start.ts",
    "claude:start": "node --no-warnings --experimental-strip-types src/companion/local-companion-start.ts --adapter claude",
    "claude:companion": "node --no-warnings --experimental-strip-types src/companion/local-companion.ts --adapter claude",
    "opencode:panel": "node --no-warnings --experimental-strip-types src/companion/local-companion.ts --adapter opencode",
    "opencode:start": "node --no-warnings --experimental-strip-types src/companion/local-companion-start.ts --adapter opencode",
    "pi:companion": "node --no-warnings --experimental-strip-types src/companion/local-companion.ts --adapter pi",
    "pi:start": "node --no-warnings --experimental-strip-types src/companion/local-companion-start.ts --adapter pi",
    "test": "bun test test",
    "test:bridge": "bun test test/bridge",
    "test:companion": "bun test test/companion",
    "test:wechat": "bun test test/wechat",
    "test:wecom": "bun test test/wecom",
    "test:watch": "bun test --watch test",
    "test:telegram": "bun test test/telegram"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode-ai/sdk": "^1.18.0",
    "@opencode/client": "^2.0.18",
    "@wecom/aibot-node-sdk": "1.0.7",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.1",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "express-rate-limit": "8.6.2",
    "fast-uri": "3.1.5",
    "hono": "4.13.3",
    "ip-address": "10.5.0",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^24.12.4",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "node-gyp": "12.1.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22.13.0"
  }
}
