---
import "../styles/global.css";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const repoUrl = "https://github.com/UNLINEARITY/CLI-WeChat-Bridge";
const npmUrl = "https://www.npmjs.com/package/cli-wechat-bridge";
const install = "npm install -g cli-wechat-bridge@latest";
const adapters = [
  { name: "Codex", command: "wechat-codex", protocol: "WebSocket RPC", icon: "codex", text: "在本地继续使用 Codex 的线程和工作区。" },
  { name: "Claude Code", command: "wechat-claude", protocol: "PTY + Hook", icon: "anthropic", text: "保留真实终端交互、会话和审批流程。" },
  { name: "OpenCode", command: "wechat-opencode", protocol: "HTTP + SSE", icon: "opencode", text: "通过本地服务继续处理会话和问题。" },
  { name: "Pi", command: "wechat-pi", protocol: "TUI + extension", icon: "pi", text: "原生 TUI 留在你的终端里运行。" },
];
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>document.documentElement.classList.add("js");</script>
<meta name="theme-color" content="#f4f5ef" /><meta name="description" content="通过微信或企业微信，把消息送进本地运行的 Codex、Claude Code、OpenCode 和 Pi。" />
<link rel="icon" href={`${base}assets/real/logo.png`} /><link rel="canonical" href="https://unlinearity.github.io/CLI-WeChat-Bridge/" />
<title>CLI WeChat Bridge｜把本地 CLI 接到微信上</title>
</head>
<body>
<header class="site-nav"><a class="brand" href={`${base}#top`}><img src={`${base}assets/real/logo.png`} alt="CLI WeChat Bridge" /></a><nav><a href={`${base}#how`}>怎么工作</a><a href={`${base}#adapters`}>支持的 CLI</a><a href={`${base}#start`}>开始使用</a></nav><div class="nav-actions"><button data-lang-toggle type="button">EN</button><a href={repoUrl} target="_blank" rel="noreferrer">GitHub ↗</a><button class="menu-toggle" data-menu-toggle type="button" aria-label="打开菜单" aria-expanded="false"><span></span><span></span></button></div></header>
<main id="top">
<section class="install-bar"><div><strong>先安装，再把消息发进本地工作区</strong><span>Node.js ≥ 22.13.0</span></div><code>{install}</code><div class="install-actions"><button data-copy={install}><span data-copy-label>复制</span></button><a href={npmUrl} target="_blank" rel="noreferrer">打开 npm ↗</a></div></section>
<section class="hero section"><div class="hero-copy reveal"><p class="kicker">微信 / 企业微信 × 本地 CLI</p><h1>把本地 CLI<br /><em>接到微信上。</em></h1><p class="hero-lede">在手机里发消息，在自己的电脑上执行。Codex、Claude Code、OpenCode 和 Pi 不需要换地方。</p><div class="hero-actions"><a class="button primary" href={`${base}#start`}>查看 3 条启动命令 ↓</a><a class="button quiet" href={repoUrl} target="_blank" rel="noreferrer">看源码 ↗</a></div><div class="hero-stats"><span><b>2</b> 个远程通道</span><span><b>4</b> 个本地 CLI</span><span><b>1</b> 个启动工作区</span></div></div><div class="hero-art reveal reveal-delay"><div class="art-halo"></div><div class="art-label">REAL MESSAGE / LOCAL EXECUTION</div><div class="art-phone"><div class="wechat-head"><span>微信</span><b>9:41</b></div><div class="wechat-title">文件传输助手</div><div class="wechat-bubble">检查当前工作区状态</div><div class="wechat-bubble me">收到，正在本地执行</div><div class="wechat-bubble done">✓ 已连接到 Codex</div><div class="wechat-input">输入消息… <b>↑</b></div></div><div class="art-terminal"><div class="terminal-head"><i></i><i></i><i></i><span>CLI-WeChat-Bridge</span></div><p><b>$</b> wechat-daemon --adapter codex</p><p class="dim">workspace / current directory</p><p class="ok">✓ waiting for a WeChat message<span></span></p></div><div class="art-line"></div><button class="demo-trigger" type="button" data-demo-trigger>&#36816;&#34892;&#19968;&#27425;&#28436;&#31034; &rarr;</button></div></section>
<section class="metrics section-pad reveal"><div><strong data-metric="stars">&mdash;</strong><span>GitHub Stars</span></div><div><strong data-metric="npmVersion">1.1.7</strong><span>npm &#26368;&#26032;&#29256;&#26412;</span></div><div><strong data-metric="downloads">&mdash;</strong><span>&#19978;&#21608; npm &#19979;&#36733;</span></div><div><strong>22.13.0</strong><span>&#26368;&#20302; Node.js</span></div></section>
<section class="how section" id="how"><div class="section-intro reveal"><p class="kicker">怎么工作</p><h2>手机负责发消息，<br /><em>电脑负责干活。</em></h2><p>daemon 绑定启动时的工作目录，保持通道在线；direct 命令则直接打开一个 CLI。</p></div><div class="steps reveal reveal-delay"><article><b>01</b><h3>登录通道</h3><p>微信运行 <code>wechat-setup</code> 扫码登录；企业微信运行 <code>wecom-setup</code> 完成配对。</p></article><article><b>02</b><h3>启动本地 CLI</h3><p>运行 <code>wechat-daemon</code>，它会在当前工作区管理 Codex、Claude Code、OpenCode 和 Pi。</p></article><article><b>03</b><h3>从微信继续操作</h3><p>普通消息和 <code>/codex</code>、<code>/claude</code>、<code>/status</code> 等指令都会回到同一个工作区。</p></article></div></section>
<section class="adapters section" id="adapters"><div class="section-intro reveal"><p class="kicker">支持的 CLI</p><h2>你熟悉的工具，<br /><em>继续在本地运行。</em></h2></div><div class="adapter-list">{adapters.map((adapter) => <article class="adapter reveal"><span class="adapter-icon" aria-hidden="true"><img src={`${base}assets/icons/${adapter.icon}.svg`} alt="" /></span><div><h3>{adapter.name}</h3><p>{adapter.text}</p><code>{adapter.command}</code></div><small>{adapter.protocol}</small></article>)}</div></section>
<section class="proof section"><div class="section-intro reveal"><p class="kicker">真实运行记录</p><h2>不是概念图，<br /><em>这是实际工作流。</em></h2><p>仓库里的截图展示了微信消息、本地终端、daemon 和结果回流。</p></div><div class="proof-grid reveal reveal-delay"><figure class="proof-large"><img src={`${base}assets/real/image-10.png`} alt="微信消息与本地工作流" loading="lazy" /><figcaption>微信消息 / 本地响应</figcaption></figure><figure><img src={`${base}assets/real/image-12.png`} alt="daemon 与 CLI 会话" loading="lazy" /><figcaption>daemon / CLI 会话</figcaption></figure><figure><img src={`${base}assets/real/image-13.png`} alt="终端与微信结果回流" loading="lazy" /><figcaption>终端 / 结果回流</figcaption></figure></div></section>
<section class="start section" id="start"><div class="section-intro reveal"><p class="kicker">开始使用</p><h2>三条命令，<br /><em>把第一条消息发进来。</em></h2><p>先安装，再登录对应通道，最后启动 daemon。命令都可以直接选中运行。</p></div><div class="command-panel reveal reveal-delay"><div class="command-tabs" role="tablist"><button class="is-active" data-command-tab="wechat" role="tab" aria-selected="true" type="button">微信</button><button data-command-tab="wecom" role="tab" aria-selected="false" type="button">企业微信</button></div><div data-command-panel="wechat"><div class="command-row"><b>01</b><code>{install}</code><button data-copy={install}>复制</button></div><div class="command-row"><b>02</b><code>wechat-setup</code><button data-copy="wechat-setup">复制</button></div><div class="command-row"><b>03</b><code>wechat-daemon</code><button data-copy="wechat-daemon">复制</button></div></div><div data-command-panel="wecom" hidden><div class="command-row"><b>01</b><code>{install}</code><button data-copy={install}>复制</button></div><div class="command-row"><b>02</b><code>wecom-setup</code><button data-copy="wecom-setup">复制</button></div><div class="command-row"><b>03</b><code>wecom-daemon</code><button data-copy="wecom-daemon">复制</button></div></div><div class="command-note">安装后如果 npm 提示阻止生命周期脚本，请按 README 的 allow-scripts 说明重新安装。</div></div></section>
<section class="closing section reveal"><p class="kicker">本地工作区仍然是你的</p><h2>从微信发一句话，<br /><em>电脑继续把事情做完。</em></h2><div class="closing-actions"><a class="button primary" href={npmUrl} target="_blank" rel="noreferrer">安装 cli-wechat-bridge ↗</a><a class="button quiet" href={repoUrl} target="_blank" rel="noreferrer">打开 GitHub ↗</a></div></section>
</main><footer class="footer section-pad"><img src={`${base}assets/real/logo.png`} alt="CLI WeChat Bridge" /><span>AGPL-3.0 · UNLINEARITY</span><span><a href={repoUrl} target="_blank" rel="noreferrer">GitHub</a> · <a href={npmUrl} target="_blank" rel="noreferrer">npm</a></span></footer><script src="../scripts/site.js"></script>
</body></html>
